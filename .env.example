# ==============================================================================
# Somiq Server - Environment Configuration Template
# Copy this file to .env.local for local development.
# DO NOT commit .env.local or production secrets to version control.
#
# Shared non-secret defaults (JWT issuer/audiences/lifetimes, DB driver, storage
# provider) live in src/main/resources/config.json. Anything set here overrides them.
# ==============================================================================

# Application Environment (LOCAL or PRODUCTION)
APP_ENV=LOCAL
PORT=8080

# JWT Secret (MUST be at least 32 characters long for HMAC-SHA256)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars!

# Database Configuration
# Local Development (H2 file-based DB). DB_DRIVER overrides the PostgreSQL default in config.json.
DB_DRIVER=org.h2.Driver
DB_URL=jdbc:h2:file:./build/db;DB_CLOSE_DELAY=-1
DB_USER=root
DB_PASSWORD=

# Production (PostgreSQL):
# DB_URL=jdbc:postgresql://<db_host>:5432/<db_name>
# DB_USER=<db_user>
# DB_PASSWORD=<db_password>

# Storage Configuration (STRATUS, GCS or LOCAL). config.json defaults to STRATUS.
# Use LOCAL to work offline without Zoho credentials.
STORAGE_PROVIDER=LOCAL

# Zoho Catalyst Stratus (required when STORAGE_PROVIDER=STRATUS)
# STRATUS_BUCKET_URL=https://somiq-uploads-development.zohostratus.in
# ZOHO_CLIENT_ID=<self-client-id>
# ZOHO_CLIENT_SECRET=<self-client-secret>
# ZOHO_REFRESH_TOKEN=<refresh-token>
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# Google Cloud Storage (only when STORAGE_PROVIDER=GCS)
# GCS_BUCKET_NAME=somiq-uploads
# GCS_PUBLIC_URL_PREFIX=https://storage.googleapis.com/somiq-uploads
# GCS_PROJECT_ID=my-gcp-project
# GCS_CREDENTIALS_PATH=/path/to/gcp-credentials.json
# GCS_CREDENTIALS_JSON={"type":"service_account",...}

# CORS Configuration (Comma-separated allowed domains / hosts)
ALLOWED_CORS_HOSTS=localhost,127.0.0.1,10.0.2.2
