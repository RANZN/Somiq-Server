    {
      "name": "Authentication",
      "item": [
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"000000\",\n  \"deviceId\": \"{{device_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns `LOGGED_IN` with tokens for an existing user, or `SIGNUP_REQUIRED` with a signup token. `000000` is the development OTP."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json.token || json;",
                  "if (token && token.accessToken) {",
                  "    pm.collectionVariables.set('auth_token', token.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', token.refreshToken);",
                  "}",
                  "if (json.signupToken) {",
                  "    pm.collectionVariables.set('signup_token', json.signupToken);",
                  "}",
                  "if (json.user && json.user.userId) {",
                  "    pm.collectionVariables.set('user_id', json.user.userId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Check User ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/check-user-id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "check-user-id"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"john_doe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Complete Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{signup_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/complete-signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "complete-signup"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"userId\": \"john_doe\",\n  \"email\": \"john@example.com\",\n  \"profilePictureUrl\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Uses the signup token from **Verify OTP** in the Authorization header."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json.token || json;",
                  "if (token && token.accessToken) {",
                  "    pm.collectionVariables.set('auth_token', token.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', token.refreshToken);",
                  "}",
                  "if (json.signupToken) {",
                  "    pm.collectionVariables.set('signup_token', json.signupToken);",
                  "}",
                  "if (json.user && json.user.userId) {",
                  "    pm.collectionVariables.set('user_id', json.user.userId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json.token || json;",
                  "if (token && token.accessToken) {",
                  "    pm.collectionVariables.set('auth_token', token.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', token.refreshToken);",
                  "}",
                  "if (json.signupToken) {",
                  "    pm.collectionVariables.set('signup_token', json.signupToken);",
                  "}",
                  "if (json.user && json.user.userId) {",
                  "    pm.collectionVariables.set('user_id', json.user.userId);",
                  "}"
                ]
              }
            }
          ]
        },
