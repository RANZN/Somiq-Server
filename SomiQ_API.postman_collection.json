{
  "info": {
    "name": "SomiQ API",
    "description": "SomiQ server API.\n\nSign in: run **Verify OTP** with the development code `000000`. If the response status is `LOGGED_IN`, the access and refresh tokens are saved automatically. If it is `SIGNUP_REQUIRED`, run **Complete Signup**, which uses the saved signup token.\n\nRequests use bearer auth with `{{auth_token}}` unless marked as public.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "signup_token",
      "value": ""
    },
    {
      "key": "phone",
      "value": "+919999999999"
    },
    {
      "key": "device_id",
      "value": "postman-device"
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "post_id",
      "value": ""
    },
    {
      "key": "reel_id",
      "value": ""
    },
    {
      "key": "comment_id",
      "value": ""
    },
    {
      "key": "story_id",
      "value": ""
    },
    {
      "key": "collection_id",
      "value": ""
    },
    {
      "key": "item_id",
      "value": ""
    },
    {
      "key": "notification_id",
      "value": ""
    }
  ],
